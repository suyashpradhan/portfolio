---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import CopyEmail from "../components/CopyEmail.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects, shipped, site } from "../data/site";
---
<Base>
  <p class="label in" style="--i:0">{site.role} · Bengaluru</p>

  <h1 class="hero in" style="--i:1">
    I build whole products: the interface, the plumbing, and now the
    <span class="circled">AI<svg viewBox="0 0 120 60" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M88 9C62 2 18 6 8 25c-9 18 22 29 55 28 33-1 56-11 52-27C111 11 84 5 58 8" /></svg></span>
    inside.
  </h1>

  <div class="intro in" style="--i:2">
    <p>
      Eight years shipping fintech, identity and enterprise products, twice as a founding engineer.
      On my own time I build AI products: voice apps with Sarvam, agents with OpenAI and Claude,
      and PostHog to see what people actually use. One made the top 50 of 13,500 in a hackathon
      run with OpenAI and Varun Mayya.
    </p>
    <p class="ctas">
      <a class="link" href="/projects">See the projects<Arrow dir="right" /></a>
      <a class="link" href="/about">More about me<Arrow dir="right" /></a>
    </p>
  </div>

  <section class="section in" style="--i:3" aria-labelledby="projects">
    <h2 id="projects" class="label">Side projects</h2>
    <div class="cards">
      {projects.map((p, i) => <ProjectCard project={p} index={i} featured={i === 0} />)}
    </div>
  </section>

  <section class="section in" style="--i:4" aria-labelledby="shipped">
    <h2 id="shipped" class="label">At work <a class="link all" href="/work">All roles<Arrow dir="right" /></a></h2>
    <ul class="list">
      {shipped.map((s, i) => (
        <li>
          <a href={s.href}>
            <span class="num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <span class="name">{s.name}</span>
            <span class="detail">{s.detail}</span>
            <Arrow dir="right" />
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="section in" style="--i:5" aria-labelledby="hello">
    <h2 id="hello" class="label">Say hello</h2>
    <p class="hello">
      Open to good product problems, AI or otherwise, and the people working on them.
    </p>
    <CopyEmail />
  </section>
</Base>

<style>
  .hero {
    font-size: clamp(2.25rem, 7vw, 3.5rem);
    font-variation-settings: "SOFT" 100, "WONK" 1, "opsz" 144;
    max-width: 16ch;
    text-wrap: balance;
  }

  .circled {
    position: relative;
    display: inline-block;
    font-style: italic;
    color: var(--accent);
    margin-inline: 0.2em 0.26em;
    padding-inline: 0.06em;
  }
  .circled svg {
    position: absolute;
    inset: -28% -40% -24% -40%;
    width: 180%;
    height: 152%;
    overflow: visible;
    pointer-events: none;
  }
  .circled path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 1.1s 0.8s cubic-bezier(0.6, 0, 0.3, 1) forwards;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  /* Hover the word and the circle redraws. */
  @media (hover: hover) {
    .circled:hover path {
      animation: redraw 0.9s cubic-bezier(0.6, 0, 0.3, 1);
    }
  }
  @keyframes redraw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  .intro {
    margin-top: 2rem;
    color: var(--muted);
    max-width: 34rem;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
  }
  .ctas .link {
    color: var(--ink);
  }

  .cards {
    display: grid;
    gap: 1rem;
  }
  h2.label {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .all {
    color: var(--muted);
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .list a {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 2rem 1fr auto auto;
    align-items: baseline;
    gap: 1rem;
    padding: 0.95rem 0;
    border-bottom: 1px solid var(--line);
    transition: padding 0.4s var(--ease), color 0.2s;
  }
  /* A wash of colour sweeps in behind the row on hover. */
  .list a::before {
    content: "";
    position: absolute;
    inset: 0 -0.75rem;
    z-index: -1;
    border-radius: 8px;
    background: var(--bg-soft);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s var(--ease);
  }
  .num {
    font-size: 0.75rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    transition: color 0.2s;
  }
  .name {
    font-family: var(--serif);
    font-size: 1.1875rem;
    font-variation-settings: "SOFT" 100;
    transition: color 0.2s;
  }
  .detail {
    color: var(--muted);
    font-size: 0.875rem;
    text-align: right;
  }
  .list .arrow {
    color: var(--accent);
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.3s, transform 0.4s var(--ease);
  }
  @media (hover: hover) {
    .list a:hover {
      padding-left: 0.4rem;
    }
    .list a:hover::before {
      transform: scaleX(1);
    }
    .list a:hover .name,
    .list a:hover .num {
      color: var(--accent);
    }
    .list a:hover .arrow {
      opacity: 1;
      transform: none;
    }
  }
  @media (max-width: 560px) {
    .list a {
      grid-template-columns: 1.75rem 1fr auto;
      gap: 0.1rem 0.75rem;
    }
    .detail {
      grid-column: 2;
      text-align: left;
    }
    .list .arrow {
      grid-row: 1 / span 2;
      grid-column: 3;
      align-self: center;
      opacity: 0.6;
      transform: none;
    }
  }

  .hello {
    font-family: var(--serif);
    font-size: 1.375rem;
    line-height: 1.4;
    font-variation-settings: "SOFT" 100;
    margin-bottom: 1rem;
    max-width: 28ch;
  }
</style>
