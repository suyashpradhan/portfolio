---
<button class="icon-btn" type="button" aria-label="Switch colour theme" title="Switch theme" data-action="theme">
  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
    <mask id="moon-cut">
      <rect width="24" height="24" fill="white" />
      <circle class="cut" cx="24" cy="4" r="7" fill="black" />
    </mask>
    <circle class="core" cx="12" cy="12" r="5" fill="currentColor" mask="url(#moon-cut)" />
    <g class="rays" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
      <path d="M12 1.8v2M12 20.2v2M1.8 12h2M20.2 12h2M4.8 4.8l1.4 1.4M17.8 17.8l1.4 1.4M4.8 19.2l1.4-1.4M17.8 6.2l1.4-1.4" />
    </g>
  </svg>
</button>

<style>
  svg * {
    transition: transform 0.6s var(--ease), opacity 0.4s var(--ease);
    transform-origin: 12px 12px;
  }
  .rays {
    transition-delay: 0.08s;
  }
  :global([data-theme="dark"]) .core {
    transform: scale(1.55);
  }
  :global([data-theme="dark"]) .cut {
    transform: translate(-8px, 6px);
  }
  :global([data-theme="dark"]) .rays {
    transform: rotate(-45deg) scale(0.5);
    opacity: 0;
    transition-delay: 0s;
  }
</style>

