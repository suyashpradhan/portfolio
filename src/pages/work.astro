---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import { roles, site } from "../data/site";
---
<Base title="Work" description="Where Suyash Pradhan has worked: CAI Software, AiPrise (YC S22), Bureau and more.">
  <p class="label in" style="--i:0">Work</p>
  <h1 class="title in" style="--i:1">Eight years, five teams, mostly <em>day one</em>.</h1>
  <p class="lede in" style="--i:2">
    I like being early: picking the stack, building the first SDK, wiring up the AI-driven flow,
    setting up the tests nobody has time for yet. Tap a role for the details.
  </p>

  <div class="roles">
    {roles.map((r, i) => (
      <details id={r.id} class="role in" style={`--i:${i + 3}`} open={i === 0}>
        <summary>
          <span class="years">
            <span>{r.from}</span><span class="dash" aria-hidden="true"></span><span>{r.to}</span>
          </span>
          <span class="head">
            <h2>
              {r.company}
              {r.note && <span class="note">{r.note}</span>}
            </h2>
            <span class="meta">{r.role}{r.place && ` · ${r.place}`}</span>
            <span class="sum">{r.summary}</span>
          </span>
          <span class="plus" aria-hidden="true"></span>
        </summary>
        <ul class="points">
          {r.points.map((p) => <li>{p}</li>)}
        </ul>
      </details>
    ))}
  </div>

  <p class="more in" style={`--i:${roles.length + 3}`}>
    <a class="link" href={site.resume} target="_blank">Full résumé (PDF)<Arrow /></a>
  </p>
</Base>

<style>
  .title {
    font-size: clamp(2rem, 6vw, 2.875rem);
    max-width: 18ch;
    text-wrap: balance;
  }
  .title em {
    color: var(--accent);
  }
  .lede {
    margin-top: 1.5rem;
    color: var(--muted);
    max-width: 34rem;
  }

  .roles {
    margin-top: 3rem;
    border-bottom: 1px solid var(--line);
  }
  .role {
    border-top: 1px solid var(--line);
    scroll-margin-top: 1.5rem;
  }

  summary {
    display: grid;
    grid-template-columns: 6.5rem 1fr 1.25rem;
    gap: 1.5rem;
    padding-block: 1.5rem;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:focus-visible {
    outline-offset: 6px;
  }

  .years {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.4rem;
    font-size: 0.8125rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    align-self: start;
  }
  .dash {
    width: 0.75rem;
    height: 1px;
    background: currentColor;
    transition: width 0.45s var(--ease), background-color 0.2s;
  }

  .head {
    display: flex;
    flex-direction: column;
  }
  h2 {
    font-size: 1.5rem;
    font-variation-settings: "SOFT" 100, "opsz" 72;
    transition: color 0.3s;
  }
  .note {
    font-family: var(--sans);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.1rem 0.5rem;
    margin-left: 0.5rem;
    vertical-align: 0.3em;
  }
  .meta {
    margin-top: 0.25rem;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .sum {
    margin-top: 0.6rem;
  }

  /* Plus that turns into a minus. */
  .plus {
    position: relative;
    width: 0.8rem;
    height: 0.8rem;
    margin-top: 0.65rem;
    justify-self: end;
    color: var(--muted);
    transition: color 0.2s;
  }
  .plus::before,
  .plus::after {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 100%;
    height: 1.5px;
    margin-top: -0.75px;
    border-radius: 1px;
    background: currentColor;
    transition: transform 0.45s var(--ease);
  }
  .plus::after {
    transform: rotate(90deg);
  }
  .role[open] .plus::after {
    transform: rotate(0deg);
  }
  .role[open] .plus {
    color: var(--accent);
  }

  @media (hover: hover) {
    summary:hover h2 {
      color: var(--accent);
    }
    summary:hover .plus {
      color: var(--accent);
    }
    summary:hover .dash {
      width: 1.4rem;
      background: var(--accent);
    }
  }

  /* Smooth open/close where the browser supports it; instant elsewhere. */
  .role::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 0.5s var(--ease),
      content-visibility 0.5s allow-discrete;
  }
  .role[open]::details-content {
    block-size: auto;
  }
  .points {
    margin: 0 0 1.75rem calc(6.5rem + 1.5rem);
    padding: 0;
    list-style: none;
    color: var(--muted);
  }
  .role[open] .points li {
    animation: rise 0.6s var(--ease) both;
  }
  .role[open] .points li:nth-child(2) { animation-delay: 60ms; }
  .role[open] .points li:nth-child(3) { animation-delay: 120ms; }
  .role[open] .points li:nth-child(4) { animation-delay: 180ms; }
  .points li {
    position: relative;
    padding-left: 1.1rem;
    margin-bottom: 0.55rem;
  }
  .points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.8em;
    width: 0.4rem;
    height: 1px;
    background: var(--accent);
  }

  @media (max-width: 560px) {
    summary {
      grid-template-columns: 1fr 1.25rem;
      gap: 0.5rem 1rem;
    }
    .years {
      grid-column: 1;
      margin: 0;
    }
    .head {
      grid-column: 1;
    }
    .plus {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: center;
      margin: 0;
    }
    .points {
      margin-left: 0;
    }
  }

  .more {
    margin-top: 2.5rem;
  }
</style>
