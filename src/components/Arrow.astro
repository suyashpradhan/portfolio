---
// Small hand-tuned arrow. "out" for external links, "right" for internal ones.
const { dir = "out" } = Astro.props as { dir?: "out" | "right" };
---
<svg class:list={["arrow", dir === "right" && "right"]} viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {dir === "right"
    ? <path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" />
    : <path d="M4.5 11.5l7-7M5.5 4.5h6v6" />}
</svg>
