---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
---
<Base title="Not found">
  <p class="label in" style="--i:0">404</p>
  <h1 class="in" style="--i:1">This page went offline, and it isn't syncing back.</h1>
  <p class="in" style="--i:2"><a class="link" href="/">Back home<Arrow dir="right" /></a></p>
</Base>

<style>
  h1 {
    font-size: clamp(2rem, 6vw, 2.75rem);
    max-width: 20ch;
    margin-bottom: 2rem;
    text-wrap: balance;
  }
</style>
