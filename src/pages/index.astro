---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import CopyEmail from "../components/CopyEmail.astro";
import { shipped } from "../data/site";
---
<Base>
  <p class="label in" style="--i:0">Senior Frontend Engineer · Bengaluru</p>

  <h1 class="hero in" style="--i:1">
    I build product interfaces and take them from
    <span class="circled">zero<svg viewBox="0 0 120 60" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M88 9C62 2 18 6 8 25c-9 18 22 29 55 28 33-1 56-11 52-27C111 11 84 5 58 8" /></svg></span>
    to shipped.
  </h1>

  <div class="intro in" style="--i:2">
    <p>
      Eight years across fintech, identity and enterprise SaaS. Twice the founding frontend engineer.
      Right now I'm rebuilding an offline-first mobile platform at CAI Software.
    </p>
    <p>
      <a class="link" href="/work">See where I've worked<Arrow dir="right" /></a>
    </p>
  </div>

  <section class="section in" style="--i:3" aria-labelledby="shipped">
    <h2 id="shipped" class="label">A few things I've shipped</h2>
    <ul class="list">
      {shipped.map((s) => (
        <li>
          <a href={s.href}>
            <span class="name">{s.name}</span>
            <span class="detail">{s.detail}</span>
            <Arrow dir="right" />
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="section in" style="--i:4" aria-labelledby="hello">
    <h2 id="hello" class="label">Say hello</h2>
    <p class="hello">
      Open to good product problems and the people working on them.
    </p>
    <CopyEmail />
  </section>
</Base>

<style>
  .hero {
    font-size: clamp(2.25rem, 7vw, 3.5rem);
    font-variation-settings: "SOFT" 100, "WONK" 1, "opsz" 144;
    max-width: 14ch;
    text-wrap: balance;
  }

  .circled {
    position: relative;
    display: inline-block;
    font-style: italic;
    color: var(--accent);
    margin-inline: 0.12em 0.18em;
  }
  .circled svg {
    position: absolute;
    inset: -28% -22% -24% -20%;
    width: 142%;
    height: 152%;
    overflow: visible;
    pointer-events: none;
  }
  .circled path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 1.1s 0.75s cubic-bezier(0.6, 0, 0.3, 1) forwards;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  .intro {
    margin-top: 2rem;
    color: var(--muted);
    max-width: 34rem;
  }
  .intro .link {
    color: var(--ink);
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .list a {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: baseline;
    gap: 1rem;
    padding: 0.95rem 0;
    border-bottom: 1px solid var(--line);
    transition: padding 0.4s var(--ease), color 0.2s;
  }
  .name {
    font-family: var(--serif);
    font-size: 1.1875rem;
    font-variation-settings: "SOFT" 100;
  }
  .detail {
    color: var(--muted);
    font-size: 0.875rem;
    text-align: right;
  }
  .list .arrow {
    color: var(--accent);
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.3s, transform 0.4s var(--ease);
  }
  @media (hover: hover) {
    .list a:hover {
      padding-left: 0.5rem;
    }
    .list a:hover .name {
      color: var(--accent);
    }
    .list a:hover .arrow {
      opacity: 1;
      transform: none;
    }
  }
  @media (max-width: 520px) {
    .list a {
      grid-template-columns: 1fr auto;
      gap: 0.1rem 1rem;
    }
    .detail {
      grid-column: 1;
      text-align: left;
    }
    .list .arrow {
      grid-row: 1 / span 2;
      grid-column: 2;
      align-self: center;
      opacity: 0.6;
      transform: none;
    }
  }

  .hello {
    font-family: var(--serif);
    font-size: 1.375rem;
    line-height: 1.4;
    font-variation-settings: "SOFT" 100;
    margin-bottom: 1rem;
    max-width: 26ch;
  }
</style>
