---
import Arrow from "./Arrow.astro";
import type { Project } from "../data/site";

interface Props {
  project: Project;
  index: number;
  featured?: boolean;
}
const { project: p, index, featured = false } = Astro.props;
---
<article class:list={["card", featured && "featured"]} id={`card-${p.id}`}>
  <span class="line" aria-hidden="true"></span>
  {p.badge && (
    <p class="badge">
      {featured && (
        <svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true">
          <path d="M10 1.8l2.2 4.6 5 .7-3.6 3.5.9 5-4.5-2.4-4.5 2.4.9-5L2.8 7.1l5-.7z" fill="currentColor" />
        </svg>
      )}
      {p.badge}
    </p>
  )}
  <h3>
    <a href={`/projects#${p.id}`} class="title">
      <span class="num" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
      {p.name}
      {p.native && <span class="native" lang="hi">{p.native}</span>}
    </a>
  </h3>
  <p class="pitch">{p.pitch}</p>
  <p class="stack">{p.stack.join(" · ")}</p>
  <p class="links">
    {p.links.map((l) => (
      <a class="link" href={l.href} target="_blank" rel="noopener noreferrer">{l.label}<Arrow /></a>
    ))}
    <a class="link more" href={`/projects#${p.id}`}>How it works<Arrow dir="right" /></a>
  </p>
</article>

<style>
  .card {
    position: relative;
    padding: 1.4rem 1.4rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--bg);
    overflow: hidden;
    transition:
      transform 0.45s var(--ease),
      border-color 0.3s,
      box-shadow 0.45s var(--ease);
  }
  .featured {
    background: linear-gradient(var(--bg-soft), var(--bg-soft)) padding-box;
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
  }
  /* An accent line that draws across the top on hover. */
  .line {
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--ease);
  }
  .featured .line {
    transform: scaleX(1);
  }
  @media (hover: hover) {
    .card:hover {
      transform: translateY(-3px);
      border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
      box-shadow: 0 18px 40px -28px rgb(60 30 10 / 0.45);
    }
    .card:hover .line {
      transform: scaleX(1);
    }
    .card:hover .num {
      color: var(--accent);
    }
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0 0 0.9rem;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--muted);
    border: 1px solid var(--line);
  }
  .featured .badge {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }
  .featured .badge svg {
    flex: none;
    animation: spin-in 0.9s 0.6s var(--ease) both;
  }
  @keyframes spin-in {
    from {
      transform: rotate(-120deg) scale(0.3);
      opacity: 0;
    }
  }

  h3 {
    font-size: 1.5rem;
    font-variation-settings: "SOFT" 100, "opsz" 72;
  }
  .featured h3 {
    font-size: clamp(1.6rem, 4.5vw, 2rem);
  }
  .title {
    display: inline-flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0 0.55rem;
  }
  .num {
    font-family: var(--sans);
    font-size: 0.75rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    transition: color 0.2s;
  }
  .native {
    font-family: system-ui, sans-serif;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .pitch {
    margin: 0.5rem 0 0.75rem;
    max-width: 34rem;
  }
  .featured .pitch {
    font-size: 1.125rem;
  }
  .stack {
    margin: 0 0 1rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin: 0;
    font-size: 0.9375rem;
  }
  .more {
    margin-left: auto;
    color: var(--muted);
  }
  @media (max-width: 480px) {
    .more {
      margin-left: 0;
    }
  }
</style>
