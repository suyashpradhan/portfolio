---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import CopyEmail from "../components/CopyEmail.astro";
import { now, site, socials, toolbox } from "../data/site";
---
<Base title="About" description="About Suyash Pradhan, a product and AI engineer in Bengaluru.">
  <p class="label in" style="--i:0">About</p>
  <h1 class="title in" style="--i:1">Hi, I'm Suyash.</h1>

  <div class="prose in" style="--i:2">
    <p>
      I started in 2017 at a tiny ed-tech company in Mumbai, writing PHP and building the
      dashboard students used for live classes. I've been shipping things people use ever since.
    </p>
    <p>
      Most of my career has been at early startups, usually as one of the first engineers. That
      means owning whatever is in front of you: identity SDKs that enterprises embed, a checkout
      handling a thousand orders a day, a fraud engine with AI-driven decisions, auth migrations,
      CI pipelines, test suites.
    </p>
    <p>
      I don't think of myself as only a frontend engineer anymore. I care about the whole
      product: what it should do, how it's built, and whether people actually use it. More and
      more, that includes AI, so that's where my time goes now: voice apps with Sarvam, agents with
      OpenAI and Claude, and learning how to make them reliable enough to ship. You can see them on
      the <a class="link" href="/projects">projects page</a>.
    </p>
  </div>

  <section class="section in" style="--i:3" aria-labelledby="now">
    <h2 id="now" class="label"><span class="live" aria-hidden="true"></span>Now</h2>
    <dl class="now">
      {now.map((n) => (
        <div>
          <dt>{n.k}</dt>
          <dd>{n.v}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="section in" style="--i:4" aria-labelledby="tools">
    <h2 id="tools" class="label">What I usually reach for</h2>
    <div class="groups">
      {toolbox.map((g) => (
        <div class="group">
          <p class="gname">{g.group}</p>
          <ul class="tools">
            {g.items.map((t) => <li>{t}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="section in" style="--i:5" aria-labelledby="elsewhere">
    <h2 id="elsewhere" class="label">Elsewhere</h2>
    <ul class="links">
      {socials.map((s) => (
        <li><a class="link" href={s.href} target="_blank" rel="noopener noreferrer">{s.label}<Arrow /></a></li>
      ))}
      <li><a class="link" href={site.resume} target="_blank">Résumé (PDF)<Arrow /></a></li>
    </ul>
    <div class="mail"><CopyEmail /></div>
  </section>

  <p class="edu in" style="--i:6">B.Sc., Mumbai University, 2017</p>
</Base>

<style>
  .title {
    font-size: clamp(2.25rem, 7vw, 3.25rem);
    font-variation-settings: "SOFT" 100, "WONK" 1, "opsz" 144;
  }
  .prose {
    margin-top: 2rem;
    max-width: 34rem;
  }

  /* A small pulsing dot: this section is current. */
  .live {
    position: relative;
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 0.55rem;
    vertical-align: 0.1em;
    border-radius: 50%;
    background: var(--accent);
  }
  .live::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--accent);
    animation: ping 2.4s var(--ease) infinite;
  }
  @keyframes ping {
    0% {
      transform: scale(1);
      opacity: 0.6;
    }
    70%,
    100% {
      transform: scale(3.2);
      opacity: 0;
    }
  }

  .now {
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .now div {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 1.5rem;
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--line);
  }
  .now dt {
    color: var(--muted);
    font-size: 0.875rem;
    padding-top: 0.15rem;
  }
  .now dd {
    margin: 0;
  }
  @media (max-width: 480px) {
    .now div {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }

  .groups {
    display: grid;
    gap: 1.25rem;
  }
  .group {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 1.5rem;
    align-items: baseline;
  }
  .gname {
    margin: 0;
    font-size: 0.875rem;
    color: var(--muted);
  }
  @media (max-width: 480px) {
    .group {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tools li {
    font-size: 0.875rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    transition: border-color 0.25s, color 0.25s, transform 0.35s var(--ease);
  }
  @media (hover: hover) {
    .tools li:hover {
      border-color: var(--accent);
      color: var(--accent);
      transform: translateY(-2px);
    }
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
  }
  .mail {
    margin-top: 0.5rem;
  }
  .edu {
    margin-top: 4rem;
    font-size: 0.875rem;
    color: var(--muted);
  }
</style>
