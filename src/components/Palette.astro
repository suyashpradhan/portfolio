---
import { site, socials } from "../data/site";

type Cmd = { id: string; label: string; cmd: string; arg?: string; hint?: string; keywords?: string };
const groups: { name: string; items: Cmd[] }[] = [
  {
    name: "Go to",
    items: [
      { id: "home", label: "Home", cmd: "go", arg: "/", keywords: "index start" },
      { id: "projects", label: "Projects", cmd: "go", arg: "/projects", keywords: "side projects apps sachet satark kahaani relay underpaid" },
      { id: "work", label: "Work", cmd: "go", arg: "/work", keywords: "experience jobs career" },
      { id: "about", label: "About", cmd: "go", arg: "/about", keywords: "bio me now" },
    ],
  },
  {
    name: "Do",
    items: [
      { id: "copy", label: "Copy email", cmd: "copy", arg: site.email, hint: site.email, keywords: "contact mail hire" },
      { id: "theme", label: "Switch theme", cmd: "theme", keywords: "dark light mode colour color" },
      { id: "sound", label: "Sound on / off", cmd: "sound", keywords: "audio mute volume" },
    ],
  },
  {
    name: "Elsewhere",
    items: [
      ...socials.map((s) => ({ id: s.label.toLowerCase(), label: s.label, cmd: "open", arg: s.href, hint: "↗", keywords: "social profile" })),
      { id: "resume", label: "Résumé", cmd: "open", arg: site.resume, hint: "PDF", keywords: "cv resume pdf" },
    ],
  },
];
---
<dialog id="palette" aria-label="Command menu">
  <div class="box">
    <div class="field">
      <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" /><path d="m13 13 4.5 4.5" /></svg>
      <input type="text" placeholder="Type a command or search…" aria-label="Search commands" role="combobox" aria-expanded="true" aria-controls="palette-list" autocomplete="off" spellcheck="false" />
      <kbd>esc</kbd>
    </div>
    <div id="palette-list" role="listbox" class="list">
      {groups.map((g) => (
        <div data-group role="group" aria-label={g.name}>
          <p class="group">{g.name}</p>
          {g.items.map((c) => (
            <div id={`cmd-${c.id}`} role="option" aria-selected="false" data-cmd={c.cmd} data-arg={c.arg} data-keywords={c.keywords ?? ""}>
              <span>{c.label}</span>
              {c.hint && <span class="hint">{c.hint}</span>}
            </div>
          ))}
        </div>
      ))}
      <p class="empty" data-empty hidden>Nothing matches. Try “work” or “email”.</p>
    </div>
    <p class="foot"><span><kbd>↑</kbd><kbd>↓</kbd> move</span><span><kbd>↵</kbd> select</span></p>
  </div>
</dialog>

<style>
  dialog {
    width: min(34rem, calc(100vw - 2rem));
    max-height: min(28rem, calc(100dvh - 6rem));
    margin: 12vh auto auto;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--bg);
    color: var(--ink);
    box-shadow: 0 24px 60px -20px rgb(40 25 10 / 0.35);
    overflow: hidden;

    /* Open/close animation, including the exit, where supported. */
    opacity: 0;
    transform: translateY(-8px) scale(0.98);
    transition:
      opacity 0.2s var(--ease),
      transform 0.3s var(--ease),
      overlay 0.3s allow-discrete,
      display 0.3s allow-discrete;
  }
  dialog[open] {
    opacity: 1;
    transform: none;
  }
  @starting-style {
    dialog[open] {
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
    }
  }
  dialog::backdrop {
    background: rgb(28 24 20 / 0);
    transition:
      background-color 0.3s,
      overlay 0.3s allow-discrete,
      display 0.3s allow-discrete;
  }
  dialog[open]::backdrop {
    background: rgb(28 24 20 / 0.35);
  }
  @starting-style {
    dialog[open]::backdrop {
      background: rgb(28 24 20 / 0);
    }
  }

  .box {
    display: flex;
    flex-direction: column;
    max-height: inherit;
  }
  .field {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.9rem 1rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
  }
  input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 1rem;
  }
  input::placeholder {
    color: var(--muted);
  }
  .list {
    overflow-y: auto;
    padding: 0.4rem;
    overscroll-behavior: contain;
  }
  .group {
    margin: 0.6rem 0.6rem 0.3rem;
    font-size: 0.75rem;
    color: var(--muted);
  }
  [role="option"] {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0.7rem;
    border-radius: 8px;
    cursor: pointer;
    transition: background-color 0.15s, padding 0.25s var(--ease);
  }
  [role="option"][aria-selected="true"] {
    background: var(--bg-soft);
    padding-left: 0.95rem;
    box-shadow: inset 2px 0 0 var(--accent);
  }
  .hint {
    color: var(--muted);
    font-size: 0.875rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .empty {
    padding: 1.5rem 0.7rem;
    margin: 0;
    color: var(--muted);
    text-align: center;
  }
  .foot {
    display: flex;
    gap: 1rem;
    margin: 0;
    padding: 0.6rem 1rem;
    border-top: 1px solid var(--line);
    font-size: 0.75rem;
    color: var(--muted);
  }
  kbd {
    font-family: var(--sans);
    font-size: 0.6875rem;
    padding: 0.05rem 0.35rem;
    margin-right: 0.2rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--bg-soft);
  }
  @media (max-width: 560px) {
    .foot {
      display: none;
    }
  }
</style>
