---
import { site } from "../data/site";
---
<span class="email">
  <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
  <button type="button" class="copy" data-action="copy" data-copy={site.email} aria-label="Copy email address">
    <span class="t idle">Copy</span>
    <span class="t done" aria-hidden="true">Copied</span>
  </button>
</span>

<style>
  .email {
    display: inline-flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
  }
  .copy {
    position: relative;
    font: inherit;
    font-size: 0.8125rem;
    color: var(--muted);
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.1rem 0.7rem;
    cursor: pointer;
    overflow: hidden;
    transition: color 0.2s, border-color 0.2s;
  }
  .copy:hover {
    color: var(--ink);
    border-color: var(--muted);
  }
  .t {
    display: block;
    transition: transform 0.4s var(--ease), opacity 0.3s;
  }
  .done {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--accent);
    transform: translateY(100%);
    opacity: 0;
  }
  .copy[data-copied] .idle {
    transform: translateY(-100%);
    opacity: 0;
  }
  .copy[data-copied] .done {
    transform: none;
    opacity: 1;
  }
</style>

